# Simon FinTech — Configuration
# Copie ce fichier en .env et remplis les valeurs.

# ─── LLM (génération du script + titre) ───
LLM_PROVIDER=groq
# Groq est gratuit : crée une clé sur https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Voix (synthèse vocale) ───
# "edge"   → Edge-TTS, gratuit, sans quota, sans clé
# "hf"     → TA voix clonée via le Space Hugging Face (voir dossier hf_space/)
# "kyutai" → Pocket TTS local (clonage local, nécessite HF_TOKEN + conditions acceptées)
TTS_ENGINE=edge

# Pour TTS_ENGINE=hf (ta voix clonée dans le cloud) :
# HF_SPACE_ID=simon5amar/simon-fintech-tts
# HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXX

# Voix française Edge-TTS. Exemples :
#   fr-FR-HenriNeural   (homme, posé)      ← défaut
#   fr-FR-DeniseNeural  (femme, chaleureuse)
#   fr-FR-RemyMultilingualNeural (homme, moderne)
EDGE_VOICE=fr-FR-HenriNeural
EDGE_RATE=+6%
EDGE_PITCH=+0Hz

# ─── Collecte ───
# Nombre d'articles collectés par épisode
MAX_ARTICLES=5

# ─── Kyutai uniquement (si TTS_ENGINE=kyutai) ───
# Fichier audio de référence pour cloner ta voix (~10 s en .wav)
# VOICE_REFERENCE=voice_reference.wav
