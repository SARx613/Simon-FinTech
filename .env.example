# Simon FinTech — Configuration
# Copie ce fichier en .env et remplis tes clés API.

# ─── Synthèse Vocale (Voix) ───
# "elevenlabs" → ElevenLabs (voix clonée haute qualité)
# "edge"       → Edge-TTS (gratuit, sans quota, sans clé)
# "hf"         → Space Hugging Face (voir hf_space/)
TTS_ENGINE=elevenlabs

# Clé ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ELEVENLABS_VOICE_ID=ZfzastaCQOj8iuzFZuWy
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Paramètres optionnels Edge-TTS (si TTS_ENGINE=edge) :
EDGE_VOICE=fr-FR-HenriNeural
EDGE_RATE=+0%
EDGE_PITCH=+0Hz

# ─── Collecte d'actualités ───
# Nombre d'articles analysés par épisode (recommandé: 5)
MAX_ARTICLES=5
