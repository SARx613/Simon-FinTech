# Simon FinTech — Configuration
# Copie ce fichier en .env et remplis les valeurs

# ─── LLM (choisis un provider) ───
LLM_PROVIDER=groq

# Groq (gratuit) — Inscris-toi sur https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OU Ollama (local, gratuit) — Installe https://ollama.com
# LLM_PROVIDER=ollama
# (pas de clé nécessaire)

# ─── Voix ───
# Chemin vers ton fichier audio de référence pour le clonage de voix
# Enregistre ~10 secondes de ta voix en .wav
VOICE_REFERENCE=voice_reference.wav
